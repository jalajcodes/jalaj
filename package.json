{
  "name": "jalaj-fyi",
  "private": true,
  "type": "module",
  "version": "4.0.0",
  "description": "Personal site and blog of Jalaj Gupta, built with Astro and Tailwind and deployed on Cloudflare.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:worker": "npm run build && wrangler dev --local"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jalajcodes/jalaj"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "astro": "^7.4.7",
    "astro-expressive-code": "^0.44.4",
    "astro-og-canvas": "^0.13.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.169.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
