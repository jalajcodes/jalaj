{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jalaj-fyi",
  "routes": [
    { "pattern": "jalaj.fyi", "custom_domain": true },
    { "pattern": "www.jalaj.fyi", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
