---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getPosts } from '../../lib'

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }))
}
const { post } = Astro.props
const { Content } = await render(post)
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <p class="meta">{date}</p>
    <h1>{post.data.title}</h1>
    <div class="tags">{post.data.tags.map((t) => <a class="tag" href={`/tags/${t}`}>#{t}</a>)}</div>
    <div class="prose" data-pagefind-body><Content /></div>
  </article>
</Base>
