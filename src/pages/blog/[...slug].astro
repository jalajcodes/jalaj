---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Chars from '../../components/Chars.astro'
import { fmtDate, getPosts, readingTime } from '../../lib'
import { abs, breadcrumbs, graph, PERSON_ID } from '../../seo'
import { SITE } from '../../data/site'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }))
}
const { post, newer, older } = Astro.props
const { Content } = await render(post)
const url = abs(`/blog/${post.id}/`)
const ld = graph(
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    image: abs(`/og/blog/${post.id}.png`),
    keywords: post.data.tags.join(', '),
    inLanguage: 'en',
    isPartOf: { '@type': 'Blog', name: `${SITE.title}'s writing`, url: abs('/blog/') },
  },
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/blog/' },
    { name: post.data.title, path: `/blog/${post.id}/` },
  ]),
)
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  ogImage={`/og/blog/${post.id}.png`}
  published={post.data.date}
  tags={post.data.tags}
  jsonLd={ld}
>
  <div id="progress" class="fixed top-0 left-0 z-50 h-0.5 w-full origin-left scale-x-0 bg-brand"></div>
  <article class="mx-auto max-w-2xl">
    <a href="/blog" class="sweep font-mono text-sm text-muted hover:text-fg">
      ← All posts
    </a>
    <p class="mt-8 font-mono text-xs text-muted">
      {fmtDate(post.data.date, true)} · {readingTime(post.body)} min read
    </p>
    <h1 class="mt-3 font-display text-4xl leading-tight sm:text-5xl">
      <Chars text={post.data.title} step={14} />
    </h1>
    <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
      {post.data.tags.map((t) => (
        <li>
          <a
            href={`/tags/${t}`}
            class="rounded-full border border-line px-3 py-1 text-muted transition-colors hover:border-brand hover:text-brand"
          >
            #{t}
          </a>
        </li>
      ))}
    </ul>
    <div class="prose prose-lg mt-10 max-w-none" data-pagefind-body>
      <Content />
    </div>

    <nav class="mt-16 grid gap-4 border-t border-line pt-8 font-mono text-sm sm:grid-cols-2" aria-label="More posts">
      {newer ? (
        <a
          href={`/blog/${newer.id}`}
          class="spot rounded-xl border border-line p-4 transition-colors hover:border-brand"
        >
          <span class="text-muted">← Newer</span>
          <br />
          <span class="font-display text-lg">{newer.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {older ? (
        <a
          href={`/blog/${older.id}`}
          class="spot rounded-xl border border-line p-4 text-right transition-colors hover:border-brand"
        >
          <span class="text-muted">Older →</span>
          <br />
          <span class="font-display text-lg">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</Base>
