---
import Base from '../layouts/Base.astro'
import { PROJECTS } from '../data/projects'
---
<Base title="Projects" description="Things I've built.">
  <h1>Projects</h1>
  <p class="lede">Things I've built.</p>
  <div class="projects">
    {PROJECTS.map((p) => (
      <a class="card" href={p.href}>
        <h3>{p.name}</h3>
        <p>{p.description}</p>
        <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </a>
    ))}
  </div>
</Base>
