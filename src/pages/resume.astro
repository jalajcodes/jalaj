---
import Base from '../layouts/Base.astro'
import Chars from '../components/Chars.astro'
import { fmtDate } from '../lib'
import { RESUME } from '../data/resume'
import { SOCIALS } from '../data/site'

const updated = fmtDate(new Date(RESUME.updated), true).replace(/ \d+,/, '')
---

<Base
  title="Resume"
  description="Resume of Jalaj Gupta, an AI-first fullstack developer in Bengaluru, India: AI agents, React, Node and AWS."
>
  <div data-pagefind-body>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-display text-[clamp(2.6rem,9vw,5.5rem)] leading-none print:text-5xl">
          <Chars text="Jalaj Gupta" />
        </h1>
        <p class="rise mt-4 font-mono text-sm text-brand" style="--d:400ms">
          {RESUME.title} · Bengaluru, India
        </p>
      </div>
      <button
        type="button"
        id="print"
        class="cursor-pointer rounded-full border border-line px-5 py-2 font-mono text-sm transition-colors hover:border-brand hover:text-brand print:hidden"
      >
        Save as PDF
      </button>
    </div>

    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm text-muted">
      <span>jalaj799 [at] gmail.com</span>
      {SOCIALS.filter((s) => ['GitHub', 'LinkedIn'].includes(s.name)).map((s) => (
        <a class="sweep hover:text-fg" href={s.href}>
          {s.name}: {s.handle}
        </a>
      ))}
      <a class="sweep hover:text-fg" href="/blog">
        jalaj.fyi/blog
      </a>
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.8fr] print:grid-cols-[1fr_1.8fr] print:gap-6">
      <div class="space-y-9 print:space-y-4">
        <section aria-labelledby="r-profile">
          <h2 id="r-profile" class="mb-3 font-display text-2xl text-brand print:text-lg">
            Profile
          </h2>
          <p class="text-muted print:text-sm">{RESUME.profile}</p>
          <p class="mt-3 text-fg print:text-sm">{RESUME.available}</p>
        </section>

        <section aria-labelledby="r-skills">
          <h2 id="r-skills" class="mb-3 font-display text-2xl text-brand print:text-lg">
            Skills
          </h2>
          <dl class="space-y-2 font-mono text-sm print:text-xs">
            {RESUME.skills.map((g) => (
              <div>
                <dt class="text-muted">{g.group}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section aria-labelledby="r-edu">
          <h2 id="r-edu" class="mb-3 font-display text-2xl text-brand print:text-lg">
            Education
          </h2>
          <ul class="space-y-2 text-sm">
            {RESUME.education.map((e) => (
              <li>
                <p class="font-semibold">{e.name}</p>
                <p class="text-muted">
                  {e.where}
                  {e.when && ` · ${e.when}`}
                </p>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <div class="space-y-10 print:space-y-4">
        <section aria-labelledby="r-exp">
          <h2 id="r-exp" class="mb-4 font-display text-2xl text-brand print:text-lg">
            Experience
          </h2>
          <ul class="space-y-8 print:space-y-3">
            {RESUME.experience.map((x) => (
              <li>
                <h3 class="text-lg font-semibold print:text-base">{x.role}</h3>
                <p class="font-mono text-sm text-muted print:text-xs">
                  {x.org} · {x.when}
                </p>
                <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm marker:text-brand print:mt-1 print:space-y-0.5 print:text-xs">
                  {x.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="r-proj">
          <h2 id="r-proj" class="mb-4 font-display text-2xl text-brand print:text-lg">
            Projects
          </h2>
          <ul class="space-y-5 print:space-y-2">
            {RESUME.projects.map((p) => (
              <li>
                <h3 class="text-lg font-semibold print:text-base">
                  <a class="sweep hover:text-brand" href={p.href}>
                    {p.name}
                  </a>
                </h3>
                <p class="font-mono text-xs text-muted">{p.stack}</p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm marker:text-brand print:text-xs">
                  {p.points.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <p class="mt-12 font-mono text-xs text-muted print:mt-4">Updated {updated}.</p>
  </div>
</Base>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print())
</script>
