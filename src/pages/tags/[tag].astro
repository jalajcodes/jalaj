---
import Base from '../../layouts/Base.astro'
import Chars from '../../components/Chars.astro'
import PostList from '../../components/PostList.astro'
import { getPosts } from '../../lib'

export async function getStaticPaths() {
  const posts = await getPosts()
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))]
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }))
}
const { tag } = Astro.params
const { posts } = Astro.props
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <h1 class="font-display text-[clamp(3rem,10vw,6rem)] leading-none text-brand"><Chars text={`#${tag}`} /></h1>
  <div class="mt-12"><PostList posts={posts} /></div>
  <p class="mt-8 font-mono text-sm"><a class="sweep text-muted hover:text-fg" href="/blog">← All posts</a></p>
</Base>
