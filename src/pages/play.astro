---
import Base from '../layouts/Base.astro'
import Chars from '../components/Chars.astro'
---
<Base title="Play" description="A tiny browser game by Jalaj Gupta: catch the code, dodge the bugs. Works with keyboard, mouse and touch.">
  <h1 class="font-display text-[clamp(3rem,10vw,6.5rem)] leading-none"><Chars text="Play" /></h1>
  <p class="rise mt-6 max-w-2xl text-lg text-muted" style="--d:400ms">
    Catch the code, dodge the bugs. Move with <kbd class="font-mono">←</kbd> <kbd class="font-mono">→</kbd> (or <kbd class="font-mono">A</kbd> <kbd class="font-mono">D</kbd>), or drag on a touch screen. <kbd class="font-mono">Space</kbd> starts, <kbd class="font-mono">P</kbd> pauses.
  </p>

  <div class="mx-auto mt-10 w-full max-w-[420px]">
    <canvas
      id="game"
      tabindex="0"
      role="application"
      aria-label="Catch the code, dodge the bugs. Use the left and right arrow keys to move, space to start."
      class="block w-full touch-none rounded-2xl border border-line bg-soft/60 outline-none transition-colors focus-visible:border-brand"
      style="aspect-ratio: 360 / 520"
    ></canvas>
    <p class="mt-4 text-center font-mono text-xs text-muted">Best: <span id="best">0</span> · Catch code for points, bugs cost a life</p>
    <p id="game-status" class="sr-only" aria-live="polite"></p>
  </div>
</Base>
<script>
  import { HEX_D, J_D } from '../data/logo'

  const canvas = document.getElementById('game') as HTMLCanvasElement
  const ctx = canvas.getContext('2d')!
  const bestEl = document.getElementById('best')!
  const status = document.getElementById('game-status')!
  const W = 360, H = 520
  const dpr = Math.min(window.devicePixelRatio || 1, 2)
  canvas.width = W * dpr
  canvas.height = H * dpr

  const hex = new Path2D(HEX_D)
  const jj = new Path2D(J_D)
  const TOKENS = ['</>', '{ }', '=>', '[]', '&&', '()', '!=', '//']
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  const css = getComputedStyle(document.documentElement)
  const c = (name: string) => css.getPropertyValue(name).trim()

  type Item = { x: number; y: number; vy: number; kind: 'code' | 'bug'; label: string; rot: number; vr: number }
  type Bit = { x: number; y: number; vx: number; vy: number; life: number; color: string; text?: string }
  type State = 'idle' | 'play' | 'paused' | 'over'

  let state: State = 'idle'
  let px = W / 2, lean = 0
  let target: number | null = null
  let left = false, right = false, dragging = false
  let items: Item[] = [], bits: Bit[] = []
  let score = 0, lives = 3, elapsed = 0, spawnIn = 0.6
  let best = 0
  try { best = Number(localStorage.getItem('jj-best')) || 0 } catch {}
  bestEl.textContent = String(best)

  const PLAYER_Y = H - 62, PLAYER_R = 24

  function start() {
    state = 'play'
    items = []; bits = []
    score = 0; lives = 3; elapsed = 0; spawnIn = 0.6
    px = W / 2; target = null
    status.textContent = 'Game started'
    canvas.focus({ preventScroll: true })
  }

  function end() {
    state = 'over'
    if (score > best) {
      best = score
      bestEl.textContent = String(best)
      try { localStorage.setItem('jj-best', String(best)) } catch {}
    }
    status.textContent = `Game over. You caught ${score}. Best ${best}.`
  }

  const burst = (x: number, y: number, color: string, n = 10) => {
    if (reduce) n = 4
    for (let i = 0; i < n; i++) {
      const a = Math.random() * Math.PI * 2, s = 40 + Math.random() * 120
      bits.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 30, life: 0.5, color })
    }
  }

  function update(dt: number) {
    elapsed += dt
    // movement: keys win over the pointer target
    const dir = (right ? 1 : 0) - (left ? 1 : 0)
    const before = px
    if (dir) { px += dir * 360 * dt; target = null }
    else if (target !== null) px += (target - px) * Math.min(1, 14 * dt)
    px = Math.max(PLAYER_R, Math.min(W - PLAYER_R, px))
    lean += (Math.max(-0.35, Math.min(0.35, (px - before) * 0.06)) - lean) * Math.min(1, 12 * dt)

    // spawning: faster and buggier the longer you survive
    spawnIn -= dt
    if (spawnIn <= 0) {
      spawnIn = Math.max(0.32, 0.95 - elapsed * 0.012)
      const bugChance = Math.min(0.45, 0.25 + elapsed * 0.003)
      const base = Math.min(340, 130 + elapsed * 4)
      const kind = Math.random() < bugChance ? 'bug' : 'code'
      items.push({
        x: 24 + Math.random() * (W - 48), y: -24,
        vy: base * (0.85 + Math.random() * 0.4), kind,
        label: TOKENS[Math.floor(Math.random() * TOKENS.length)],
        rot: Math.random() * 6, vr: (Math.random() - 0.5) * 3,
      })
    }

    for (const it of items) { it.y += it.vy * dt; it.rot += it.vr * dt }
    items = items.filter((it) => {
      const d = Math.hypot(it.x - px, it.y - PLAYER_Y)
      if (d < PLAYER_R + (it.kind === 'bug' ? 12 : 14)) {
        if (it.kind === 'code') {
          score++
          burst(it.x, it.y, c('--brand'))
          bits.push({ x: it.x, y: it.y - 10, vx: 0, vy: -50, life: 0.7, color: c('--brand'), text: '+1' })
        } else {
          lives--
          burst(it.x, it.y, c('--hot'), 16)
          if (lives <= 0) end()
        }
        return false
      }
      return it.y < H + 30
    })

    for (const b of bits) { b.x += b.vx * dt; b.y += b.vy * dt; b.vy += (b.text ? 0 : 260) * dt; b.life -= dt }
    bits = bits.filter((b) => b.life > 0)
  }

  function drawMark(x: number, y: number, size: number, rot = 0, color = c('--brand'), jjOn = true) {
    ctx.save()
    ctx.translate(x, y)
    ctx.rotate(rot)
    const s = size / 150
    ctx.scale(s, s)
    ctx.translate(-92.5, -93)
    ctx.strokeStyle = color
    ctx.fillStyle = color
    ctx.lineWidth = 9
    ctx.lineJoin = 'round'
    ctx.stroke(hex)
    if (jjOn) {
      ctx.translate(92.5, 93.5); ctx.scale(1.95, 1.95); ctx.translate(-92.5, -93.5)
      ctx.fill(jj)
    }
    ctx.restore()
  }

  function drawBug(x: number, y: number, rot: number) {
    ctx.save()
    ctx.translate(x, y)
    ctx.rotate(Math.sin(rot * 2) * 0.35)
    const col = c('--hot')
    ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = 2; ctx.lineCap = 'round'
    for (const k of [-1, 0, 1]) {
      ctx.beginPath(); ctx.moveTo(-8, k * 6); ctx.lineTo(-16, k * 9); ctx.moveTo(8, k * 6); ctx.lineTo(16, k * 9); ctx.stroke()
    }
    ctx.beginPath(); ctx.moveTo(-3, -12); ctx.lineTo(-7, -19); ctx.moveTo(3, -12); ctx.lineTo(7, -19); ctx.stroke()
    ctx.beginPath(); ctx.ellipse(0, 3, 9, 12, 0, 0, Math.PI * 2); ctx.fill()
    ctx.beginPath(); ctx.arc(0, -10, 6, 0, Math.PI * 2); ctx.fill()
    ctx.strokeStyle = c('--bg'); ctx.lineWidth = 1.5
    ctx.beginPath(); ctx.moveTo(0, -6); ctx.lineTo(0, 14); ctx.stroke()
    ctx.restore()
  }

  function centered(text: string, y: number, font: string, color: string) {
    ctx.font = font
    ctx.fillStyle = color
    ctx.textAlign = 'center'
    ctx.fillText(text, W / 2, y)
  }

  function draw() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    ctx.clearRect(0, 0, W, H)
    ctx.textBaseline = 'middle'
    const mono = '700 22px "JetBrains Mono Variable", ui-monospace, monospace'

    for (const it of items) {
      if (it.kind === 'bug') drawBug(it.x, it.y, it.rot)
      else {
        ctx.save(); ctx.translate(it.x, it.y); ctx.rotate(Math.sin(it.rot) * 0.2)
        ctx.font = mono; ctx.textAlign = 'center'; ctx.fillStyle = c('--brand'); ctx.fillText(it.label, 0, 0)
        ctx.restore()
      }
    }

    for (const b of bits) {
      ctx.globalAlpha = Math.max(0, b.life * 2)
      if (b.text) { ctx.font = '700 16px "JetBrains Mono Variable", monospace'; ctx.fillStyle = b.color; ctx.textAlign = 'center'; ctx.fillText(b.text, b.x, b.y) }
      else { ctx.fillStyle = b.color; ctx.fillRect(b.x - 2, b.y - 2, 4, 4) }
    }
    ctx.globalAlpha = 1

    if (state !== 'idle') drawMark(px, PLAYER_Y, 58, lean)
    else drawMark(W / 2, PLAYER_Y, 58)

    // HUD
    ctx.textAlign = 'left'; ctx.font = '600 15px "JetBrains Mono Variable", monospace'; ctx.fillStyle = c('--fg')
    ctx.fillText(`Score ${score}`, 14, 22)
    ctx.textAlign = 'right'; ctx.fillStyle = c('--muted'); ctx.fillText(`Best ${best}`, W - 14, 22)
    for (let i = 0; i < 3; i++) drawMark(W / 2 + (i - 1) * 24, 22, 18, 0, i < lives ? c('--brand') : c('--line'), false)

    if (state !== 'play') {
      ctx.globalAlpha = 0.82; ctx.fillStyle = c('--bg'); ctx.fillRect(0, 0, W, H); ctx.globalAlpha = 1
      const display = '400 34px Righteous, ui-sans-serif, sans-serif'
      const small = '500 14px "JetBrains Mono Variable", monospace'
      if (state === 'idle') {
        centered('Catch the code', 200, display, c('--fg'))
        centered('Dodge the bugs', 244, display, c('--brand'))
        centered('Tap, click or press Space to start', 300, small, c('--muted'))
      } else if (state === 'paused') {
        centered('Paused', 230, display, c('--fg'))
        centered('Press P or tap to resume', 280, small, c('--muted'))
      } else {
        centered('Bugged out!', 190, display, c('--hot'))
        centered(`You caught ${score}`, 238, '600 18px "JetBrains Mono Variable", monospace', c('--fg'))
        centered(score >= best && score > 0 ? 'New best score!' : `Best: ${best}`, 270, small, c('--brand'))
        centered('Tap or press Space to play again', 320, small, c('--muted'))
      }
    }
  }

  let last = performance.now()
  function frame(t: number) {
    const dt = Math.min(0.05, (t - last) / 1000)
    last = t
    if (state === 'play') update(dt)
    draw()
    requestAnimationFrame(frame)
  }
  requestAnimationFrame(frame)

  // --- input ---
  const toggleStart = () => {
    if (state === 'idle' || state === 'over') start()
    else if (state === 'paused') state = 'play'
  }
  const pause = () => { if (state === 'play') state = 'paused'; else if (state === 'paused') state = 'play' }
  const pointerX = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect()
    return ((e.clientX - r.left) / r.width) * W
  }

  addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase()
    const focused = document.activeElement === canvas
    const gameKey = ['arrowleft', 'arrowright', ' ', 'a', 'd', 'p', 'escape'].includes(k)
    if (!gameKey || (!focused && state !== 'play')) return
    if (k === 'arrowleft' || k === 'a') left = true
    else if (k === 'arrowright' || k === 'd') right = true
    else if (k === ' ') toggleStart()
    else if (k === 'p' || k === 'escape') pause()
    if (['arrowleft', 'arrowright', ' '].includes(k)) e.preventDefault()
  })
  addEventListener('keyup', (e) => {
    const k = e.key.toLowerCase()
    if (k === 'arrowleft' || k === 'a') left = false
    else if (k === 'arrowright' || k === 'd') right = false
  })
  canvas.addEventListener('pointerdown', (e) => {
    canvas.focus({ preventScroll: true })
    canvas.setPointerCapture(e.pointerId)
    dragging = true
    if (state === 'idle' || state === 'over' || state === 'paused') toggleStart()
    target = pointerX(e)
  })
  canvas.addEventListener('pointermove', (e) => {
    if (state === 'play' && (dragging || e.pointerType === 'mouse')) target = pointerX(e)
  })
  const release = () => { dragging = false }
  canvas.addEventListener('pointerup', release)
  canvas.addEventListener('pointercancel', release)
  addEventListener('blur', () => { left = right = false; if (state === 'play') state = 'paused' })
  document.addEventListener('visibilitychange', () => { if (document.hidden && state === 'play') state = 'paused' })
</script>
