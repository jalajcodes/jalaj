---
import Base from '../layouts/Base.astro'
import Chars from '../components/Chars.astro'
---
<Base title="Not found" noindex>
  <div class="py-10 text-center">
    <p class="font-mono text-sm text-brand">Error 404</p>
    <h1 class="mt-4 font-display text-[clamp(5rem,22vw,14rem)] leading-none"><Chars text="404" step={90} /></h1>
    <p class="rise mt-6 text-lg text-muted" style="--d:600ms">This page isn't in the cache. Try squishing the letters, then head home.</p>
    <a href="/" class="rise mt-8 inline-flex rounded-full bg-brand px-6 py-3 font-mono text-sm font-medium text-brand-ink transition-transform hover:-translate-y-0.5" style="--d:700ms">Take me home →</a>
    <p class="rise mt-6 font-mono text-sm text-muted" style="--d:800ms">Or, while you are here, <button type="button" data-shoot-page class="sweep cursor-pointer text-brand">shoot this page</button>.</p>
  </div>
</Base>
