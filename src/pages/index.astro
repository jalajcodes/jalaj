---
import Base from '../layouts/Base.astro'
import Chars from '../components/Chars.astro'
import ProjectCard from '../components/ProjectCard.astro'
import PostList from '../components/PostList.astro'
import { PROJECTS } from '../data/projects'
import { HEADLINE_SKILLS, PROOF, SOCIALS } from '../data/site'
import { WORK } from '../data/work'
import { getPosts } from '../lib'
import { graph, person, website } from '../seo'

const posts = (await getPosts()).slice(0, 3)
const featured = PROJECTS.filter((p) => p.featured)
const [lead, ...rest] = featured
---

<Base jsonLd={graph(website(), person())}>
  <section class="pb-16 sm:pb-24">
    <p class="rise font-mono text-sm text-brand" style="--d:0ms">
      Lead Software Development Engineer · Bengaluru, India
    </p>
    <h1 class="mt-5 font-display leading-[0.95] text-[clamp(3.4rem,13vw,9rem)]">
      <Chars text="Hey, I'm" />
      <br />
      <Chars text="Jalaj." delay={200} class="text-brand" />
    </h1>
    <p class="rise mt-8 max-w-2xl text-lg text-muted sm:text-xl" style="--d:500ms">
      I lead engineering across the whole stack and build AI agents that take work from ticket to production. Five years
      of shipping, most recently on AWS with Amazon Bedrock AgentCore. I'm looking for a full-time remote lead role, and
      I'm open to freelance and other roles too.
    </p>
    <div class="rise mt-9 flex flex-wrap gap-4 font-mono text-sm" style="--d:650ms">
      <a
        href="/about#contact"
        class="group inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-brand-ink font-medium transition-transform hover:-translate-y-0.5"
      >
        Get in touch <span class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
      </a>
      <a
        href="/resume"
        class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 transition-colors hover:border-brand hover:text-brand"
      >
        View resume
      </a>
      <a href="#work" class="sweep inline-flex items-center px-2 py-3 text-muted hover:text-fg">
        See my work ↓
      </a>
    </div>
    <dl class="rise mt-12 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4" style="--d:800ms">
      {PROOF.map((x) => (
        <div>
          <dt class="font-display text-4xl text-brand sm:text-5xl">{x.n}</dt>
          <dd class="mt-1 font-mono text-xs text-muted">{x.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="-mx-5 overflow-hidden border-y border-line py-4" aria-hidden="true">
    <div class="marquee font-display text-2xl text-muted">
      {[0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {HEADLINE_SKILLS.map((s) => (
            <li class="px-6">
              {s}
              <span class="ml-12 text-brand">✦</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <section id="work" class="mt-20 scroll-mt-24">
    <div class="mb-8" data-reveal>
      <h2 class="font-display text-4xl sm:text-5xl">
        <Chars text="Work" />
      </h2>
      <p class="mt-3 max-w-2xl text-muted">What I have built and shipped, and what changed because of it.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {WORK.map((w, i) => (
        <article
          data-reveal
          style={`--d:${i * 70}ms`}
          class="spot flex flex-col rounded-2xl border border-line bg-soft/60 p-6 sm:p-7"
        >
          <p class="font-mono text-xs text-muted">
            {w.org} · {w.when}
          </p>
          <h3 class="mt-2 font-display text-2xl leading-tight">{w.title}</h3>
          <p class="mt-3 text-sm text-muted">
            <span class="text-fg">Problem.</span> {w.problem}
          </p>
          <p class="mt-2 text-sm text-muted">
            <span class="text-fg">What I did.</span> {w.did}
          </p>
          <p class="mt-2 text-sm">
            <span class="text-brand">Result.</span> {w.result}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {w.stack.map((t) => (
              <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">{t}</li>
            ))}
          </ul>
          {w.href && (
            <a class="sweep mt-auto self-start pt-5 font-mono text-sm text-brand" href={w.href}>
              {w.hrefLabel} →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="mt-24">
    <div class="mb-8 flex items-end justify-between" data-reveal>
      <h2 class="font-display text-4xl sm:text-5xl">
        <Chars text="Side projects" />
      </h2>
      <a href="/projects" class="sweep font-mono text-sm text-muted hover:text-fg">
        All projects →
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <ProjectCard project={lead} big />
      {rest.map((p, i) => (
        <ProjectCard project={p} delay={(i + 1) * 80} />
      ))}
    </div>
  </section>

  <section class="mt-24">
    <div class="mb-8 flex items-end justify-between" data-reveal>
      <h2 class="font-display text-4xl sm:text-5xl">
        <Chars text="Latest writing" />
      </h2>
      <a href="/blog" class="sweep font-mono text-sm text-muted hover:text-fg">
        All posts →
      </a>
    </div>
    <PostList posts={posts} />
  </section>

  <section class="mt-24 rounded-3xl border border-line bg-soft/60 p-8 sm:p-12" data-reveal>
    <h2 class="font-display text-4xl sm:text-6xl leading-none">
      <Chars text="Let's talk." />
    </h2>
    <p class="mt-4 max-w-lg text-muted">
      I'm looking for a full-time remote lead role, and I'm open to freelance and other roles. The quickest way to reach
      me is a message on LinkedIn or X, or the email on my{' '}
      <a class="sweep text-brand" href="/about#contact">
        About page
      </a>
      . My code lives on GitHub.
    </p>
    <ul class="mt-8 grid gap-3 font-mono text-sm sm:grid-cols-2">
      {SOCIALS.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="group spot flex items-center justify-between rounded-xl border border-line bg-bg px-5 py-4 transition-colors hover:border-brand"
          >
            <span>{s.name}</span>
            <span class="text-muted group-hover:text-brand">{s.handle} ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
