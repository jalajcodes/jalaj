---
import { NAV } from '../data/site'
import LogoMark from './LogoMark.astro'
const path = Astro.url.pathname
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/75 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:px-5">
    <a
      href="/"
      id="logo"
      class="group flex touch-manipulation items-center gap-2.5"
      aria-label="Jalaj Gupta, home"
      title="Double-click to replay the intro"
    >
      <span class="logo-orbit">
        <LogoMark class="size-8 sm:size-9 text-brand" />
      </span>
      <span class="hidden font-display text-lg tracking-wide sm:inline">
        <span class="hjj">J</span>ala<span class="hjj">j</span> Gupta
      </span>
    </a>
    <nav
      aria-label="Main"
      class="flex items-center gap-3 text-[13px] max-[419px]:gap-2.5 max-[419px]:text-xs max-[339px]:gap-1.5 min-[420px]:gap-4 sm:gap-5 sm:text-sm lg:gap-7"
    >
      {NAV.map((n) => (
        <a
          href={n.href}
          data-scramble
          class:list={[
            'sweep font-mono',
            path.startsWith(n.href) ? 'text-fg [background-size:100%_2px]' : 'text-muted hover:text-fg',
          ]}
          aria-current={path.startsWith(n.href) ? 'page' : undefined}
        >
          {n.label}
        </a>
      ))}
      <a
        href="/about#contact"
        class="hidden rounded-full bg-brand px-4 py-1.5 font-mono text-sm font-medium text-brand-ink transition-transform hover:-translate-y-0.5 md:inline-flex"
      >
        Get in touch
      </a>
      <a href="/search" aria-label="Search" title="Search ( / )" class="text-muted transition-colors hover:text-brand">
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle light and dark theme"
        class="text-muted transition-colors hover:text-brand cursor-pointer"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5 hidden dark:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          viewBox="0 0 24 24"
          class="size-5 dark:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </nav>
  </div>
</header>
<script>
  const root = document.documentElement
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Theme switch: a circle grows out from the click (View Transitions), with a plain fallback.
  // Five quick switches in a row start disco mode for a few seconds.
  let flips: number[] = []
  // While a page transition runs the browser sends clicks to the page root instead of the button, so this listens on
  // the document and also matches by position (as the logo does). Without that, quick clicks never reach the button.
  const btn = document.getElementById('theme-toggle')
  let switching = false
  document.addEventListener('click', (e) => {
    if (!btn) return
    const hit = btn.getBoundingClientRect()
    const onBtn =
      !!(e.target as HTMLElement | null)?.closest?.('#theme-toggle') ||
      (e.clientX >= hit.left &&
        e.clientX <= hit.right &&
        e.clientY >= hit.top &&
        e.clientY <= hit.bottom &&
        e.detail > 0)
    if (!onBtn) return
    if (!reduce) {
      btn.classList.add('spin')
      setTimeout(() => btn.classList.remove('spin'), 520)
      const now = Date.now()
      flips = [...flips.filter((t) => now - t < 3000), now]
      if (flips.length >= 5) {
        flips = []
        root.classList.add('disco')
        setTimeout(() => root.classList.remove('disco'), 4000)
      }
    }
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
    const apply = () => {
      root.dataset.theme = next
      try {
        localStorage.setItem('theme', next)
      } catch {}
    }
    // A switch during a running transition just applies at once, so fast clicking stays fast.
    if (!document.startViewTransition || reduce || switching) return apply()
    // Keyboard activation reports 0,0, so grow from the button's centre instead of the corner.
    const me = e as MouseEvent
    const box = btn.getBoundingClientRect()
    const x = me.detail === 0 ? box.left + box.width / 2 : me.clientX
    const y = me.detail === 0 ? box.top + box.height / 2 : me.clientY
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
    root.classList.add('vt-theme')
    switching = true
    const t = document.startViewTransition(apply)
    t.ready.then(() =>
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
        { duration: 650, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
      ),
    )
    t.finished.finally(() => {
      root.classList.remove('vt-theme')
      switching = false
    })
  })

  // Nav text scramble on hover.
  const GLYPHS = '!<>-_\\/[]{}=+*^?#abcdefghijklmnopqrstuvwxyz'
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const final = el.textContent ?? ''
    el.setAttribute('aria-label', final)
    let timer = 0
    el.addEventListener('pointerenter', () => {
      if (reduce) return
      clearInterval(timer)
      let frame = 0
      timer = window.setInterval(() => {
        const settled = Math.floor(frame / 2)
        el.textContent = [...final]
          .map((c, i) => (i < settled ? c : GLYPHS[Math.floor(Math.random() * GLYPHS.length)]))
          .join('')
        if (++frame > final.length * 2 + 2) {
          clearInterval(timer)
          el.textContent = final
        }
      }, 30)
    })
  })
</script>
