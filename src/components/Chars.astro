---
// Splits text into characters: staggered entrance, then a rubber-band wave across a word when the pointer enters it.
interface Props { text: string; as?: string; class?: string; delay?: number; step?: number; still?: boolean }
const { text, as = 'span', class: cls = '', delay = 0, step = 28, still = false } = Astro.props
const Tag = as as 'span'
let n = 0
const words = text.split(' ').map((w) => [...w].map((c) => ({ c, i: n++ })))
---
<Tag class:list={['chars', cls]} aria-label={text} style={`--base:${delay}ms;--step:${step}ms`}>
  {words.map((w, wi) => (
    <>
      <span class="w inline-block whitespace-nowrap" aria-hidden="true">
        {w.map(({ c, i }) => <span class={still ? 'ch-still' : 'ch'} style={`--i:${i}`}><span class="ci">{c}</span></span>)}
      </span>{wi < words.length - 1 && ' '}
    </>
  ))}
</Tag>
<script>
  // Hover a letter and just that letter squishes. Enter a word from outside and a ripple runs through the whole
  // word, starting at the letter you touched.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  const STEP = 45
  const squish = (letter: HTMLElement, order: number) => {
    if (letter.classList.contains('bounce')) return
    letter.style.setProperty('--j', String(order))
    letter.classList.add('bounce')
    const done = () => letter.classList.remove('bounce')
    letter.addEventListener('animationend', done, { once: true })
    setTimeout(done, 900 + order * STEP + 150) // safety net if animationend never fires
  }
  let current: HTMLElement | null = null
  document.addEventListener('pointerover', (e) => {
    if (reduce) return
    const target = e.target as HTMLElement
    const letter = target.closest?.('.ci') as HTMLElement | null
    const word = target.closest?.('.w') as HTMLElement | null
    if (!letter || !word) { current = null; return }
    if (word === current) { squish(letter, 0); return } // moving between letters inside a word
    current = word // entering a word
    const letters = [...word.querySelectorAll<HTMLElement>('.ci')]
    const from = letters.indexOf(letter)
    letters.forEach((l, i) => squish(l, Math.abs(i - from)))
  })
</script>
