---
interface Props {
  type: 'agents' | 'scales' | 'meal' | 'speed'
}
const { type } = Astro.props
---

{type === 'agents' && (
  <svg
    viewBox="0 0 320 80"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full"
    role="img"
    aria-label="Agent delivery flow: Ticket to Code to Review to Test to Deploy to Production"
  >
    {/* flow boxes */}
    {['Ticket', 'Code', 'Review', 'Test', 'Deploy', 'Prod'].map((label, i) => (
      <>
        <rect
          x={i * 54 + 2}
          y="24"
          width="42"
          height="32"
          rx="6"
          class={i === 5 ? 'fill-brand/20 stroke-brand' : 'fill-soft stroke-line'}
          stroke-width="1"
        />
        <text
          x={i * 54 + 23}
          y="44"
          text-anchor="middle"
          class={i === 5 ? 'fill-brand' : 'fill-muted'}
          font-size="9"
          font-family="monospace"
        >
          {label}
        </text>
        {i < 5 && (
          <path
            d={`M${i * 54 + 46} 40 L${(i + 1) * 54} 40`}
            class="stroke-brand/50"
            stroke-width="1.5"
            stroke-linecap="round"
            marker-end="url(#arrow)"
          />
        )}
        {i > 0 && i < 5 && (
          <>
            <text
              x={i * 54 + 23}
              y="68"
              text-anchor="middle"
              class="fill-brand/60"
              font-size="6"
              font-family="monospace"
            >
              AI
            </text>
            <text
              x={i * 54 + 23}
              y="18"
              text-anchor="middle"
              class="fill-muted"
              font-size="5.5"
              font-family="monospace"
            >
              ✓ human
            </text>
          </>
        )}
      </>
    ))}
    <defs>
      <marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6" class="fill-none stroke-brand/50" stroke-width="1" />
      </marker>
    </defs>
  </svg>
)}

{type === 'scales' && (
  <svg
    viewBox="0 0 320 80"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full"
    role="img"
    aria-label="Scale connects via Bluetooth or Wi-Fi to phone app, which sends data to server and displays metrics"
  >
    {/* Scale icon */}
    <rect x="10" y="26" width="50" height="32" rx="8" class="fill-soft stroke-line" stroke-width="1" />
    <text x="35" y="46" text-anchor="middle" class="fill-muted" font-size="8" font-family="monospace">
      Scale
    </text>
    {/* BLE / WiFi label */}
    <text x="90" y="35" text-anchor="middle" class="fill-brand/60" font-size="7" font-family="monospace">
      BLE
    </text>
    <text x="90" y="52" text-anchor="middle" class="fill-brand/60" font-size="7" font-family="monospace">
      Wi-Fi
    </text>
    {/* Arrow to phone */}
    <path d="M62 42 L110 42" class="stroke-brand/50" stroke-width="1.5" stroke-dasharray="3 2" />
    {/* Phone */}
    <rect x="112" y="22" width="40" height="40" rx="8" class="fill-brand/15 stroke-brand" stroke-width="1" />
    <text x="132" y="46" text-anchor="middle" class="fill-brand" font-size="8" font-family="monospace">
      App
    </text>
    {/* Arrow to server */}
    <path
      d="M154 42 L190 42"
      class="stroke-brand/50"
      stroke-width="1.5"
      stroke-linecap="round"
      marker-end="url(#arrow2)"
    />
    {/* Server */}
    <rect x="192" y="26" width="44" height="32" rx="6" class="fill-soft stroke-line" stroke-width="1" />
    <text x="214" y="46" text-anchor="middle" class="fill-muted" font-size="8" font-family="monospace">
      API
    </text>
    {/* Arrow to metrics */}
    <path
      d="M238 42 L258 42"
      class="stroke-brand/50"
      stroke-width="1.5"
      stroke-linecap="round"
      marker-end="url(#arrow2)"
    />
    {/* Metrics */}
    <rect x="260" y="20" width="52" height="44" rx="6" class="fill-soft stroke-line" stroke-width="1" />
    <text x="286" y="38" text-anchor="middle" class="fill-fg" font-size="7" font-family="monospace">
      15+
    </text>
    <text x="286" y="50" text-anchor="middle" class="fill-muted" font-size="7" font-family="monospace">
      metrics
    </text>
    <defs>
      <marker id="arrow2" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6" class="fill-none stroke-brand/50" stroke-width="1" />
      </marker>
    </defs>
  </svg>
)}

{type === 'meal' && (
  <svg
    viewBox="0 0 320 80"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full"
    role="img"
    aria-label="User inputs preferences, AI generates a meal plan with recipes and a grocery list"
  >
    {/* Input */}
    <rect x="6" y="18" width="60" height="48" rx="6" class="fill-soft stroke-line" stroke-width="1" />
    <text x="36" y="34" text-anchor="middle" class="fill-muted" font-size="7" font-family="monospace">
      Goals
    </text>
    <text x="36" y="44" text-anchor="middle" class="fill-muted" font-size="7" font-family="monospace">
      Diet
    </text>
    <text x="36" y="54" text-anchor="middle" class="fill-muted" font-size="7" font-family="monospace">
      Allergies
    </text>
    {/* Arrow */}
    <path
      d="M68 42 L100 42"
      class="stroke-brand/50"
      stroke-width="1.5"
      stroke-linecap="round"
      marker-end="url(#arrow3)"
    />
    {/* AI box */}
    <rect x="102" y="24" width="48" height="36" rx="8" class="fill-brand/15 stroke-brand" stroke-width="1" />
    <text x="126" y="46" text-anchor="middle" class="fill-brand" font-size="10" font-family="monospace">
      AI
    </text>
    {/* Arrow */}
    <path
      d="M152 42 L180 42"
      class="stroke-brand/50"
      stroke-width="1.5"
      stroke-linecap="round"
      marker-end="url(#arrow3)"
    />
    {/* Output cards */}
    {['Meals', 'Recipes', 'Nutrition', 'Groceries'].map((label, i) => (
      <g>
        <rect
          x="182"
          y={10 + i * 17}
          width="62"
          height="14"
          rx="4"
          class={i === 0 ? 'fill-brand/15 stroke-brand/40' : 'fill-soft stroke-line'}
          stroke-width="0.8"
        />
        <text
          x="213"
          y={20 + i * 17}
          text-anchor="middle"
          class={i === 0 ? 'fill-brand' : 'fill-muted'}
          font-size="7"
          font-family="monospace"
        >
          {label}
        </text>
      </g>
    ))}
    <defs>
      <marker id="arrow3" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6" class="fill-none stroke-brand/50" stroke-width="1" />
      </marker>
    </defs>
  </svg>
)}

{type === 'speed' && (
  <svg
    viewBox="0 0 320 80"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full"
    role="img"
    aria-label="Before: score 50, Ruby APIs, manual sign-up. After: score 95+, Node APIs, Google sign-up, audit tool"
  >
    {/* Before column */}
    <rect x="10" y="8" width="130" height="68" rx="8" class="fill-soft stroke-line" stroke-width="1" />
    <text x="75" y="22" text-anchor="middle" class="fill-muted" font-size="8" font-family="monospace">
      Before
    </text>
    <line x1="20" y1="27" x2="130" y2="27" class="stroke-line" stroke-width="0.5" />
    <text x="30" y="40" class="fill-muted" font-size="8" font-family="monospace">
      Speed: 50
    </text>
    <text x="30" y="52" class="fill-muted" font-size="8" font-family="monospace">
      Ruby APIs
    </text>
    <text x="30" y="64" class="fill-muted" font-size="8" font-family="monospace">
      Manual sign-up
    </text>
    {/* Arrow */}
    <path d="M144 42 L174 42" class="stroke-brand" stroke-width="2" stroke-linecap="round" marker-end="url(#arrow4)" />
    {/* After column */}
    <rect x="178" y="8" width="134" height="68" rx="8" class="fill-brand/10 stroke-brand" stroke-width="1" />
    <text x="245" y="22" text-anchor="middle" class="fill-brand" font-size="8" font-family="monospace">
      After
    </text>
    <line x1="188" y1="27" x2="302" y2="27" class="stroke-brand/30" stroke-width="0.5" />
    <text x="198" y="40" class="fill-fg" font-size="8" font-family="monospace">
      Speed: 95+
    </text>
    <text x="198" y="52" class="fill-fg" font-size="8" font-family="monospace">
      Node APIs
    </text>
    <text x="198" y="64" class="fill-fg" font-size="8" font-family="monospace">
      Google sign-up
    </text>
    <defs>
      <marker id="arrow4" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6" class="fill-none stroke-brand" stroke-width="1.5" />
      </marker>
    </defs>
  </svg>
)}
