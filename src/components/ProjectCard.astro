---
import { repoUrl, type Project } from '../data/projects'
interface Props {
  project: Project
  big?: boolean
  delay?: number
}
const { project: p, big = false, delay = 0 } = Astro.props
---

<article
  data-reveal
  style={`--d:${delay}ms`}
  class:list={[
    'spot group flex flex-col rounded-2xl border border-line bg-soft/60 p-6 transition-colors hover:border-brand/60',
    big && 'sm:col-span-2 sm:p-8',
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class:list={['font-display leading-tight', big ? 'text-4xl sm:text-5xl' : 'text-2xl']}>{p.name}</h3>
    <span class="shrink-0 whitespace-nowrap font-mono text-xs text-muted pt-2">
      {p.year}
      {p.stars ? ` · ★ ${p.stars}` : ''}
    </span>
  </div>
  <p class:list={['mt-3 text-muted', big ? 'max-w-xl text-lg' : 'text-sm']}>{p.blurb}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {p.stack.map((s) => (
      <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">{s}</li>
    ))}
  </ul>
  <div class="mt-auto flex gap-5 pt-6 font-mono text-sm">
    {p.live && (
      <a class="sweep text-brand" href={p.live} target="_blank" rel="noopener noreferrer">
        Live ↗
      </a>
    )}
    <a class="sweep" href={repoUrl(p.slug)} target="_blank" rel="noopener noreferrer">
      Code ↗
    </a>
  </div>
</article>
