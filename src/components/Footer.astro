---
import { SOCIALS } from '../data/site'
import Chars from './Chars.astro'
---
<footer class="mt-24 overflow-hidden border-t border-line">
  <div class="mx-auto max-w-5xl px-5 pt-10">
    <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-muted">
      <p class="font-mono">© {new Date().getFullYear()} Jalaj Gupta · Jaipur, India</p>
      <ul class="flex flex-wrap gap-5 font-mono">
        {SOCIALS.map((s) => <li><a class="sweep hover:text-fg" href={s.href} target="_blank" rel="me noopener noreferrer">{s.name}</a></li>)}
        <li><a class="sweep hover:text-fg" href="/play">Play</a></li>
        <li><button type="button" data-shoot-page title="Or just type “shoot” on your keyboard" class="sweep cursor-pointer hover:text-fg">Shoot the page</button></li>
        <li><a class="sweep hover:text-fg" href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>
  <div class="select-none text-center font-display leading-none outline-text text-[clamp(5rem,26vw,19rem)] -mb-[0.12em] mt-4" aria-hidden="true">
    <Chars text="JALAJ" still />
  </div>
</footer>
<script>
  // "Shoot the page" can start from any page. The game is only downloaded when you ask for it.
  const launch = async () => {
    const { startAsteroids } = await import('../scripts/asteroids')
    startAsteroids()
  }
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest?.('[data-shoot-page]')) launch()
  })
  // Or type the word "shoot" anywhere (not in a text field, and not with Ctrl/Cmd/Alt held).
  let typed = ''
  let typedAt = 0
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.key.length !== 1) return
    const t = e.target as HTMLElement | null
    if (t?.matches?.('input,textarea,select') || t?.isContentEditable) return
    const now = Date.now()
    if (now - typedAt > 1500) typed = ''
    typedAt = now
    typed = (typed + e.key.toLowerCase()).slice(-5)
    if (typed === 'shoot') { typed = ''; launch() }
  })
  // "Play again" reloads the page (to restore the text) and sets this flag, so the game restarts right away.
  try {
    if (sessionStorage.getItem('jj-shoot')) {
      sessionStorage.removeItem('jj-shoot')
      addEventListener('load', () => setTimeout(launch, 350))
    }
  } catch {}
</script>
