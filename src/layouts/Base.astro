---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Preloader from '../components/Preloader.astro'
import Blob from '../components/Blob.astro'
import { SITE } from '../data/site'
import { abs } from '../seo'
// Preload the three Latin font files every page uses, so the browser fetches them in parallel with the
// stylesheet instead of discovering them after the first layout (which is what causes the visible swap).
import righteousFont from '@fontsource/righteous/files/righteous-latin-400-normal.woff2?url'
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
  noindex?: boolean
  published?: Date
  tags?: string[]
  jsonLd?: object
}
const { title, description = SITE.description, type = 'website', noindex = false, published, tags = [], jsonLd } = Astro.props
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`
const canonical = new URL(Astro.url.pathname, SITE.url)
const image = abs('/og.png')
const imageAlt = 'Jalaj Gupta, fullstack developer from Jaipur, India'
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" as="font" type="font/woff2" href={righteousFont} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interFont} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={monoFont} crossorigin="anonymous" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="author" content={SITE.title} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.url} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jalajcodes" />
    <meta name="twitter:creator" content="@jalajcodes" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (function () {
        var d = document.documentElement
        try {
          var t = localStorage.getItem('theme')
          if (t !== 'light' && t !== 'dark') t = 'dark' // dark by default; a saved choice wins
          d.dataset.theme = t
          var bot = /bot|crawl|spider|slurp|lighthouse|preview|facebookexternalhit/i.test(navigator.userAgent)
          var skip = bot || sessionStorage.getItem('jj-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches || location.pathname !== '/'
          d.classList.add(skip ? 'intro-done' : 'intro-run')
        } catch (e) { d.classList.add('intro-done') }
      })()
      // Double-click the logo to replay the intro. This lives in the head and listens on the document so it is
      // ready before anything can be clicked. The logo is a link: the first click may already be navigating when
      // the second one arrives (on the new page), so the time of the last logo click is kept in sessionStorage
      // and a second click within 600ms counts as the replay.
      document.addEventListener('click', function (e) {
        var logo = e.target && e.target.closest && e.target.closest('#logo')
        if (!logo) return
        var now = Date.now(), last = 0, home = location.pathname === '/'
        try { last = Number(sessionStorage.getItem('jj-logo-click')) || 0 } catch (err) {}
        if (now - last < 600) {
          e.preventDefault()
          try { sessionStorage.removeItem('jj-intro'); sessionStorage.removeItem('jj-logo-click') } catch (err) {}
          if (home) location.reload(); else location.href = '/'
          return
        }
        try { sessionStorage.setItem('jj-logo-click', String(now)) } catch (err) {}
        if (home) {
          e.preventDefault()
          window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
        }
      })
    </script>
    <noscript><style>[data-reveal],.rise,.ch{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <Preloader />
    <Blob />
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1 px-5 pt-12 sm:pt-16"><slot /></main>
    <Footer />
    <script>
      // Reveal on scroll: anything at or above the bottom of the viewport is shown
      // (position-based, so jumping or restoring a scroll position never leaves content hidden)
      let pending = [...document.querySelectorAll<HTMLElement>('[data-reveal]')]
      let ticking = false
      const reveal = () => {
        ticking = false
        const limit = innerHeight * 0.92
        pending = pending.filter((el) => {
          if (el.getBoundingClientRect().top < limit) { el.classList.add('in'); return false }
          return true
        })
        if (!pending.length) removeEventListener('scroll', onScroll)
      }
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(reveal) } }
      addEventListener('scroll', onScroll, { passive: true })
      addEventListener('resize', onScroll)
      reveal()

      // External links (including ones inside Markdown posts) open in a new tab
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        if (!/^https?:$/.test(a.protocol) || a.hostname === location.hostname || a.target) return
        a.target = '_blank'
        a.rel = [...new Set([...a.rel.split(' ').filter(Boolean), 'noopener', 'noreferrer'])].join(' ')
      })

      // Spotlight cards follow the cursor
      document.querySelectorAll<HTMLElement>('.spot').forEach((el) =>
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect()
          el.style.setProperty('--mx', e.clientX - r.left + 'px')
          el.style.setProperty('--my', e.clientY - r.top + 'px')
        }),
      )

      // Copy buttons on code blocks
      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
        const b = document.createElement('button')
        b.className = 'copy-btn'
        b.type = 'button'
        b.textContent = 'Copy'
        b.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(pre.innerText.replace(/Copy$/, '').trimEnd()); b.textContent = 'Copied' } catch { b.textContent = 'Press ⌘C' }
          setTimeout(() => (b.textContent = 'Copy'), 1500)
        })
        pre.appendChild(b)
      })

      // Reading progress on posts
      const bar = document.getElementById('progress')
      if (bar) {
        const set = () => {
          const h = document.documentElement
          bar.style.transform = `scaleX(${Math.min(1, h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight))})`
        }
        addEventListener('scroll', set, { passive: true })
        set()
      }
    </script>
  </body>
</html>
